  "components": [
    {
      "name": "Botón principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal de la zona: Analizar, Entré, Guardar.",
      "html": "<button class=\"ds-btn ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg>Analizar</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:0 16px;border-radius:6px;font-family:'Inter Variable',Inter,system-ui,sans-serif;font-weight:600;font-size:.875rem;cursor:pointer;white-space:nowrap;transition:background .15s,border-color .15s,transform .1s}.ds-btn-primary{background:var(--accent-fill,#6d28d9);border:1px solid var(--accent-fill,#6d28d9);color:#fff}.ds-btn-primary:hover{background:var(--accent-fill-hover,#7c3aed);border-color:var(--accent-fill-hover,#7c3aed)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--accent,#a78bfa);outline-offset:2px}"
    },
    {
      "name": "Botón secundario",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Acción secundaria: Copiar niveles, Reintentar.",
      "html": "<button class=\"ds-btn-sec\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"8\" y=\"2\" width=\"8\" height=\"4\" rx=\"1\"/><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"/></svg>Copiar niveles</button>",
      "css": ".ds-btn-sec{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 16px;border-radius:6px;border:1px solid var(--line-2,#3a3350);background:var(--s2,#1a1725);color:var(--text,#ece9f4);font-family:'Inter Variable',Inter,system-ui,sans-serif;font-weight:600;font-size:.875rem;cursor:pointer;transition:background .15s}.ds-btn-sec:hover{background:var(--s3,#221e2f)}.ds-btn-sec:active{transform:translateY(1px)}.ds-btn-sec:focus-visible{outline:2px solid var(--accent,#a78bfa);outline-offset:2px}"
    },
    {
      "name": "Botón fantasma",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Acción terciaria sin peso visual.",
      "html": "<button class=\"ds-btn-ghost\">Cancelar</button>",
      "css": ".ds-btn-ghost{height:36px;padding:0 16px;border-radius:6px;border:1px solid transparent;background:transparent;color:var(--text-2,#aea7c2);font-family:'Inter Variable',Inter,system-ui,sans-serif;font-weight:600;font-size:.875rem;cursor:pointer;transition:background .15s}.ds-btn-ghost:hover{background:var(--s2,#1a1725);color:var(--text,#ece9f4)}.ds-btn-ghost:focus-visible{outline:2px solid var(--accent,#a78bfa);outline-offset:2px}"
    },
    {
      "name": "Campo con unidad",
      "kind": "input",
      "refersTo": "input",
      "description": "Campo de 36 px con etiqueta encima y la unidad como sufijo.",
      "html": "<label class=\"ds-field\"><span>Capital</span><span class=\"ds-wrap\"><input class=\"ds-input\" value=\"22.6\"/><span class=\"ds-suf\">USDT</span></span></label>",
      "css": ".ds-field{display:grid;gap:6px;font-family:'Inter Variable',Inter,system-ui,sans-serif;max-width:240px}.ds-field>span:first-child{font-size:.8125rem;color:var(--text-2,#aea7c2);font-weight:500}.ds-wrap{position:relative;display:flex;align-items:center}.ds-input{height:36px;width:100%;padding:0 52px 0 12px;border-radius:6px;border:1px solid var(--line-2,#3a3350);background:var(--s2,#1a1725);color:var(--text,#ece9f4);font:inherit;font-size:.875rem;font-variant-numeric:tabular-nums;transition:border-color .15s,box-shadow .15s}.ds-input:hover{border-color:var(--text-3,#8f88a8)}.ds-input:focus{outline:none;border-color:var(--accent,#a78bfa);box-shadow:0 0 0 3px var(--accent-soft,rgba(76,141,255,.14))}.ds-suf{position:absolute;right:12px;color:var(--text-3,#8f88a8);font-size:.8125rem;pointer-events:none}"
    },
    {
      "name": "Etiquetas de lado",
      "kind": "chip",
      "refersTo": "tag-gain",
      "description": "LONG, SHORT y NO OPERAR: color con flecha o icono, nunca solo color.",
      "html": "<span class=\"ds-tags\"><span class=\"ds-tag ds-gain\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"/><path d=\"M7 17 17 7\"/></svg>LONG</span><span class=\"ds-tag ds-loss\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m7 7 10 10\"/><path d=\"M17 7v10H7\"/></svg>SHORT</span><span class=\"ds-tag\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m4.9 4.9 14.2 14.2\"/></svg>NO OPERAR</span></span>",
      "css": ".ds-tags{display:flex;gap:8px}.ds-tag{display:inline-flex;align-items:center;gap:4px;height:22px;padding:0 8px;border-radius:4px;font-family:'Inter Variable',Inter,system-ui,sans-serif;font-size:.75rem;font-weight:650;letter-spacing:.02em;background:var(--s3,#221e2f);color:var(--text-2,#aea7c2)}.ds-gain{background:var(--gain-soft,rgba(46,189,133,.14));color:var(--gain-text,#2ebd85)}.ds-loss{background:var(--loss-soft,rgba(246,70,93,.14));color:var(--loss-text,#f6465d)}"
    },
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Contenedor con cabecera y filas de dato separadas por filetes de 1 px.",
      "html": "<section class=\"ds-panel\"><header class=\"ds-ph\"><h2>Historial real</h2><span>últimas 27 h</span></header><div class=\"ds-row\"><span>Operaciones con este plan</span><b>16</b></div><div class=\"ds-row\"><span>Ganadoras</span><b>63 %</b></div><div class=\"ds-row\"><span>Resultado medio (con comisiones)</span><b class=\"ds-up\">+0.05 R</b></div></section>",
      "css": ".ds-panel{background:var(--s1,#13111b);border:1px solid var(--line,#29243a);border-radius:8px;max-width:360px;font-family:'Inter Variable',Inter,system-ui,sans-serif;font-size:.875rem;color:var(--text,#ece9f4)}.ds-ph{display:flex;align-items:center;min-height:46px;padding:12px 16px;border-bottom:1px solid var(--line,#29243a)}.ds-ph h2{margin:0;font-size:.875rem;font-weight:600}.ds-ph span{margin-left:auto;font-size:.8125rem;color:var(--text-2,#aea7c2)}.ds-row{display:flex;justify-content:space-between;margin:0 16px;padding:9px 0;border-bottom:1px solid var(--line,#29243a)}.ds-row:last-child{border-bottom:0}.ds-row span{color:var(--text-2,#aea7c2)}.ds-row b{font-weight:550;font-variant-numeric:tabular-nums}.ds-up{color:var(--gain-text,#2ebd85)}"
    },
    {
      "name": "Navegación lateral",
      "kind": "nav",
      "refersTo": "nav-link-active",
      "description": "Barra lateral de 220 px; el activo en superficie 3 con icono morado.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nl\" href=\"#\">Inicio</a><a class=\"ds-nl\" href=\"#\" aria-current=\"page\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M13 2 3 14h9l-1 8 10-12h-9l1-8z\"/></svg>Señal</a><a class=\"ds-nl\" href=\"#\">Posición<i class=\"ds-dot\"></i></a></nav>",
      "css": ".ds-nav{width:220px;background:var(--s1,#13111b);border-right:1px solid var(--line,#29243a);padding:16px 12px;display:flex;flex-direction:column;gap:1px;font-family:'Inter Variable',Inter,system-ui,sans-serif;font-size:.875rem}.ds-nl{display:flex;align-items:center;gap:12px;padding:7px 8px;border-radius:6px;color:var(--text-2,#aea7c2);text-decoration:none;font-weight:500;transition:background .15s,color .15s}.ds-nl:hover{background:var(--s2,#1a1725);color:var(--text,#ece9f4)}.ds-nl[aria-current=page]{background:var(--s3,#221e2f);color:var(--text,#ece9f4)}.ds-nl[aria-current=page] svg{color:var(--accent,#a78bfa)}.ds-nl:focus-visible{outline:2px solid var(--accent,#a78bfa);outline-offset:2px}.ds-dot{margin-left:auto;width:7px;height:7px;border-radius:50%;background:var(--warn,#e5a93b)}"
    },
    {
      "name": "Fila del reloj",
      "kind": "custom",
      "description": "Cuenta regresiva con barra que se vacía; ámbar cuando queda poco.",
      "html": "<div class=\"ds-clock\"><div class=\"ds-cr\"><span class=\"w\">La entrada caduca</span><span class=\"a\">a las 07:51</span><span class=\"l\">4:58</span><i class=\"m\"><b style=\"width:96%\"></b></i></div><div class=\"ds-cr soon\"><span class=\"w\">Sin TP1, cierra</span><span class=\"a\">a las 08:08</span><span class=\"l\">0:42</span><i class=\"m\"><b style=\"width:8%\"></b></i></div></div>",
      "css": ".ds-clock{background:var(--s1,#13111b);border:1px solid var(--line,#29243a);border-radius:8px;max-width:360px;font-family:'Inter Variable',Inter,system-ui,sans-serif;color:var(--text,#ece9f4)}.ds-cr{display:grid;grid-template-columns:1fr auto;gap:2px 12px;align-items:center;padding:12px 16px;border-bottom:1px solid var(--line,#29243a)}.ds-cr:last-child{border-bottom:0}.ds-cr .w{font-size:.8125rem;color:var(--text-2,#aea7c2)}.ds-cr .a{font-size:.8125rem;color:var(--text-3,#8f88a8);text-align:right}.ds-cr .l{font-size:1.25rem;font-weight:650;letter-spacing:-.01em;font-variant-numeric:tabular-nums}.ds-cr .m{grid-column:1/-1;height:3px;background:var(--s3,#221e2f);border-radius:2px;overflow:hidden;margin-top:6px;display:block}.ds-cr .m b{display:block;height:100%;background:var(--accent,#a78bfa)}.ds-cr.soon .l{color:var(--warn-text,#f2bd57)}.ds-cr.soon .m b{background:var(--warn,#e5a93b)}"
    }
  ],
  "narrative": {
