# Copia este archivo a app/.env.local con los datos de tu proyecto de Supabase
# (Project Settings → API). Sin ellos la app corre en modo demo con datos grabados.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Suscripción (página /suscripcion): Binance Pay ID donde se paga y a dónde se envía el comprobante.
VITE_BINANCE_PAY_ID=
VITE_CONTACTO_URL=https://t.me/tu_usuario
VITE_CONTACTO_TEXTO=Telegram @tu_usuario
